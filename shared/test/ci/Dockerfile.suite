# The container the suites run in. Playwright's Python image brings Python, Playwright and a Chromium the
# accessibility suite drives. The PostgreSQL client is what the conformance suite uses to grant its
# fixtures, since relationships come into existence only through the organisation-only stored procedure.
FROM mcr.microsoft.com/playwright/python:v1.49.1-noble

# The image ships the browsers but not the Python package for the system interpreter. Pin the package to
# the image's Playwright version so the bundled browsers match it.
RUN apt-get update \
 && apt-get install -y --no-install-recommends postgresql-client \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir --break-system-packages playwright==1.49.1

WORKDIR /repo/shared/test
