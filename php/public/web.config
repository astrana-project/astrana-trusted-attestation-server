<?xml version="1.0" encoding="UTF-8"?>
<!--
  The IIS configuration, for Windows hosting such as Plesk on Windows, and for a Windows server of your own.
  It does under IIS what .htaccess does under Apache, rule for rule, and needs the URL Rewrite module, which
  Windows hosting provides. PHP itself is set up by the host or the control panel, not here. The PHP settings
  the server needs, which .htaccess sets under Apache's PHP module, PHP reads under IIS from .user.ini beside
  this file.
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <!--
      The application's own error responses carry a status code and nothing else. Without PassThrough, IIS
      replaces them with its own error pages.
    -->
    <httpErrors existingResponse="PassThrough" />

    <!-- IIS announces ASP.NET on every response by default. The other two implementations name no runtime. -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <rewrite>
      <rules>
        <rule name="Redirect trailing slashes if not a folder" stopProcessing="true">
          <match url="^(.+)/$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>

        <!--
          Never served as files: anything under a path segment that starts with a dot, and robots.txt and
          favicon.ico, Laravel skeleton names the other two implementations do not serve. They go to the
          application, which answers HTTP 404 - Not Found as it does for any path it does not know, and which
          serves /.well-known/ata-manifest.json itself. .htaccess and the container's router (server.php)
          hand the same paths to the application.
        -->
        <rule name="Never served as files" stopProcessing="true">
          <match url="(^|/)(\.|robots\.txt$|favicon\.ico$)" ignoreCase="true" />
          <action type="Rewrite" url="index.php" />
        </rule>

        <rule name="Send requests to the front controller" stopProcessing="true">
          <match url="^" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>

      <!--
        The stylesheet and the favicon are served by IIS directly and never reach Laravel, so
        App\Http\Middleware\SecurityHeaders does not set these on them. Each rule fills its header only where
        the response lacks it, as Header setifempty does under Apache, and leaves the application's own
        headers untouched. HSTS is absent, because it belongs to the site's TLS settings, as the PHP
        installation page (docs/installation/php.md) says.
      -->
      <outboundRules>
        <!--
          PHP names its version in an X-Powered-By header unless php.ini turns it off, which a hosting account
          often cannot. The customHeaders entry above removes only the header IIS itself adds. URL Rewrite can
          empty a header but not remove it, so this rule leaves PHP's header with no value, which names
          nothing. .htaccess removes it under Apache, and the container's php.ini stops PHP adding it in the
          image.
        -->
        <rule name="No X-Powered-By from PHP">
          <match serverVariable="RESPONSE_X_Powered_By" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
        <rule name="X-Content-Type-Options where absent">
          <match serverVariable="RESPONSE_X_Content_Type_Options" pattern="^$" />
          <action type="Rewrite" value="nosniff" />
        </rule>
        <rule name="X-Frame-Options where absent">
          <match serverVariable="RESPONSE_X_Frame_Options" pattern="^$" />
          <action type="Rewrite" value="DENY" />
        </rule>
        <rule name="Referrer-Policy where absent">
          <match serverVariable="RESPONSE_Referrer_Policy" pattern="^$" />
          <action type="Rewrite" value="no-referrer" />
        </rule>
        <rule name="X-XSS-Protection where absent">
          <match serverVariable="RESPONSE_X_XSS_Protection" pattern="^$" />
          <action type="Rewrite" value="0" />
        </rule>
        <rule name="Cache-Control where absent">
          <match serverVariable="RESPONSE_Cache_Control" pattern="^$" />
          <action type="Rewrite" value="no-cache, no-store, max-age=0, must-revalidate" />
        </rule>
      </outboundRules>
    </rewrite>
  </system.webServer>
</configuration>
