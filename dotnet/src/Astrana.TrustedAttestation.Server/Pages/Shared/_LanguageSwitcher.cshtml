@using System.Globalization
@inject Astrana.TrustedAttestation.Server.Services.UiStrings Strings
@inject Astrana.TrustedAttestation.Server.Services.LocalizationSettings Localization
@*
    The language switcher: a compact disclosure in the top-right showing a translate icon and the current
    language; opening it lists the languages the organisation offers (decision record 34 in docs/adr). Each choice
    posts to /set-language, which stores it in a validated cookie and returns here. Native <details>, so it
    works with no JavaScript; shown only when the organisation offers more than one locale.
*@
@{
    var current = CultureInfo.CurrentUICulture.Name;
    var currentLanguage = current.Contains('-') ? current[..current.IndexOf('-')] : current;
    var returnTo = Context.Request.Path + Context.Request.QueryString;

    bool IsActive(string locale) =>
        string.Equals(locale, current, StringComparison.OrdinalIgnoreCase)
        || string.Equals(locale, currentLanguage, StringComparison.OrdinalIgnoreCase);

    var active = Localization.Locales.FirstOrDefault(IsActive) ?? Localization.Locales[0];
}
@if (Localization.ShowSwitcher)
{
    <details class="ata-language">
        <summary>
            @* The translate glyph (inlined, currentColor -- no icon font or external request). Bootstrap
               Icons "translate", MIT-licensed. Decorative: the visible language name carries the meaning. *@
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M4.545 6.714 4.11 8H3l1.862-5h1.284L8 8H6.833l-.435-1.286zm1.634-.736L5.5 3.956h-.049l-.679 2.022z" />
                <path d="M0 2a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v3h3a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-3H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h7a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zm7.138 9.995q.289.451.63.846c-.748.575-1.673 1.001-2.768 1.292.178.217.451.635.555.867 1.125-.359 2.08-.844 2.886-1.494.777.665 1.739 1.165 2.93 1.472.133-.254.414-.673.629-.89-1.125-.253-2.057-.694-2.82-1.284.681-.747 1.222-1.651 1.621-2.757H14V8h-3v1.047h.765c-.318.844-.74 1.546-1.272 2.13a6 6 0 0 1-.415-.492 2 2 0 0 1-.94.31" />
            </svg>
            <span class="visually-hidden">@Strings["language_label"]: </span>
            <span>@Strings.Get("language_endonym", active)</span>
        </summary>
        <form method="post" action="/set-language" class="ata-language-menu">
            <input type="hidden" name="next" value="@returnTo" />
            @foreach (var locale in Localization.Locales)
            {
                var isActive = IsActive(locale);
                <button type="submit" name="locale" value="@locale"
                        class="btn btn-sm btn-link text-start p-1 @(isActive ? "fw-bold" : null)"
                        aria-current="@(isActive ? "true" : null)">@Strings.Get("language_endonym", locale)</button>
            }
        </form>
    </details>
}
