<?xml version="1.0" encoding="utf-8"?>
<!--
  The Internet Information Services (IIS) configuration, for hosting the published server on Windows. dotnet publish
  adds the ASP.NET Core Module handler to this file and keeps everything here. The rules need the URL Rewrite module.
-->
<configuration>
  <system.webServer>
    <!-- IIS announces ASP.NET on every response by default. No response from the server names its runtime. -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <rewrite>
      <!--
        A site can set a server variable only once the variable is allowed. URL Rewrite locks this section by default,
        and while it is locked IIS answers every request with HTTP 500.19, its configuration error, and the server
        sees nothing. The server administrator unlocks the section for the site, or allows the seven variables at
        server level and removes this element.
      -->
      <allowedServerVariables>
        <add name="HTTP_X_FORWARDED_PROTO" />
        <add name="HTTP_X_FORWARDED_HOST" />
        <add name="HTTP_X_FORWARDED_FOR" />
        <add name="HTTP_X_FORWARDED_PORT" />
        <add name="HTTP_X_FORWARDED_PREFIX" />
        <add name="HTTP_X_FORWARDED_SSL" />
        <add name="HTTP_FORWARDED" />
      </allowedServerVariables>

      <!-- The scheme IIS received the request over, from its HTTPS server variable. -->
      <rewriteMaps>
        <rewriteMap name="Scheme">
          <add key="on" value="https" />
          <add key="off" value="http" />
        </rewriteMap>
      </rewriteMaps>

      <rules>
        <!--
          IIS passes the client's own headers to the server unchanged, and with Tls:TerminatedByProxy set the server
          builds its addresses from X-Forwarded-Proto and X-Forwarded-Host. A visitor who could send them would
          choose the scheme and host. This rule does what a proxy in front does. It sets the scheme and host from
          what IIS itself received, and empties the other forwarded headers, which the server does not read. URL
          Rewrite cannot take a header away, and the server refuses an empty X-Forwarded-Proto, so the scheme is set
          rather than emptied. A request IIS received over plain HTTP is therefore refused by the server.
        -->
        <rule name="Replace forwarded headers a client sent">
          <match url=".*" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="{Scheme:{HTTPS}}" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_FOR" value="" />
            <set name="HTTP_X_FORWARDED_PORT" value="" />
            <set name="HTTP_X_FORWARDED_PREFIX" value="" />
            <set name="HTTP_X_FORWARDED_SSL" value="" />
            <set name="HTTP_FORWARDED" value="" />
          </serverVariables>
          <action type="None" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
