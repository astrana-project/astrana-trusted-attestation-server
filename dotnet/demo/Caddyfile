# Terminates TLS in front of the application. Caddy issues the certificate from its own local
# certificate authority, so there is nothing to generate. The browser does not trust that authority and
# warns once, which is correct behaviour for a demonstration.
#
# Caddy also sets X-Forwarded-Proto and X-Forwarded-Host itself, replacing anything the client sent. The
# application needs X-Forwarded-Proto because, with TLS ending here, it cannot see the scheme itself, and
# it refuses any request the proxy marks as plain HTTP. The application reads no other forwarded header, but the
# header_up lines remove Forwarded, X-Forwarded-Port, X-Forwarded-Prefix and X-Forwarded-Ssl anyway, so no
# header the client sent arrives under a forwarded name.
{
	auto_https disable_redirects
}

localhost:15443 {
	tls internal
	reverse_proxy gateway:8080 {
		header_up -Forwarded
		header_up -X-Forwarded-Port
		header_up -X-Forwarded-Prefix
		header_up -X-Forwarded-Ssl
	}
}
